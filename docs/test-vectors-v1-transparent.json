        "balance": 500000000,
        "nonce": 0,
        "guardian_enabled": false,
        "pending_transfers": [],
        "coinbase_tranches": []
      }
    },
    "step_1_alice_sends_protected_first_time_transfer": {
      "block_height": 100,
      "action": "Alice sends 100,000,000 atoms (1 OWN) to Bob (new recipient)",
