  "coinbase_maturity_scenarios": {
    "rule_summary": "Coinbase rewards must mature for 100 blocks (unlock_height = height + 100). The transparent account ledger tracks immature rewards in canonical per-account coinbase_tranches. spendable_balance = balance - sum(immature_coinbase_tranches). A transaction must not spend immature coinbase value even when mingled with mature funds. At block height >= unlock_height, tranches mature and are removed from the account state.",
    "case_1_new_coinbase_reward": {
      "description": "Miner receives block 1 coinbase reward (10 OWN). Reward is recorded as an immature tranche; spendable balance remains 0.",
      "block_height": 1,
      "coinbase_tx_id": "38ba81669098c844c5657d3418c5541a8bf4e186f1f1879ff816bc146229c9da",
      "payout_atoms": 1000000000,
      "maturity_delay_blocks": 100,
      "unlock_height": 101,
      "miner_state_after": {
        "balance": 1000000000,
        "nonce": 0,
        "immature_coinbase_balance": 1000000000,
        "spendable_balance": 0,
        "coinbase_tranches": [
          {
            "coinbase_tx_id": "38ba81669098c844c5657d3418c5541a8bf4e186f1f1879ff816bc146229c9da",
            "amount": 1000000000,
            "unlock_height": 101
          }
        ]
      },
      "spend_validation_at_height_1": {
        "attempted_spend_atoms": 100000000,
        "spendable_balance": 0,
        "result": "REJECTED (ErrImmatureCoinbaseSpend: spend exceeds spendable balance)"
      }
    },
    "case_2_partially_mature_account": {
      "description": "Miner has 500,000,000 mature atoms, then mines block 100 receiving 1,000,000,000 atoms reward. Total balance is 1,500,000,000, but only 500,000,000 is spendable.",
      "block_height": 100,
      "coinbase_tx_id": "26b11fa7b981aa2956c5a4c4d93a4a76bab6b7b63dd07cf3c45d7e2dddf9d061",
      "payout_atoms": 1000000000,
